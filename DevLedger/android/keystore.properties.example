# Copy this file to keystore.properties (git-ignored) and fill in YOUR values.
# NEVER commit the real file, the .jks keystore, or these passwords.
# Generate a keystore with scripts/generate-keystore.sh (or .ps1).
storeFile=../../keystore/devledger-upload.jks
storePassword=change-me
keyAlias=devledger-upload
