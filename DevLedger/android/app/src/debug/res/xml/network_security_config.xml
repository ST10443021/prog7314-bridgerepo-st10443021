<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG builds only: allow plaintext HTTP to the Android emulator's host-loopback alias so a
  locally-run API can be used during development (Google Developers, n.d.k).
  The release build uses src/main/res/xml/network_security_config.xml, which forbids cleartext.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
